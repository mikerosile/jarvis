# ROCm Settings
HSA_OVERRIDE_GFX_VERSION=10.3.0
ROCR_VISIBLE_DEVICES="0"

# PyTorch Settings
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL="0"

# Open-WebUI Settings
ENABLE_RAG_LOCAL_WEB_FETCH=true
OPEN_WEBUI_APP_PORT=8086
CONTEXT_COMPACTION_TOKEN_THRESHOLD=120000
WEBUI_SECRET_KEY="$(openssl rand -hex 32)"
WEBUI_URL="https://your.host.name.com:8443"

# Open Terminal Settings
OPEN_TERMINAL_API_KEY="$(openssl rand -base64 30 | tr -d '/' | tr -d '+')"
OPEN_TERMINAL_CORS_ALLOWED_ORIGINS="https://your.host.name.com:8443"
OPEN_TERMINAL_MULTI_USER="true"

# Docling Settings
DOCLING_API_KEY="$(openssl rand -hex 32)"
DOCLING_NUM_THREADS=8
DOCLING_PORT=5001

# SearX NG Settings
SEARXNG_VERSION=latest
SEARXNG_HOST=[::]
SEARXNG_PORT=8089
SEARXNG_QUERY_URL="http://your.host.name.com:8089/search?q=<query>"
