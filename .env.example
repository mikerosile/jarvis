# llama.cpp Settings
GGML_VK_VISIBLE_DEVICES="1"
# Open-WebUI Settings
OPEN_WEBUI_APP_PORT=8086
WEBUI_SECRET_KEY=$(openssl rand -hex 32) 
# Open Terminal Settings
OPEN_TERMINAL_API_KEY=$(openssl rand -base64 48 | tr -d '/' | tr -d '+')
# Docling Settings
DOCLING_API_KEY=$(openssl rand -hex 32)
# SearX NG Settings
SEARXNG_VERSION=latest
SEARXNG_HOST=[::]
SEARXNG_PORT=8089
SEARXNG_QUERY_URL="http://$(hostname -f):8089/search?q=<query>"
